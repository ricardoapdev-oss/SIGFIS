# Configuração do banco de dados PostgreSQL
# Substitua os valores conforme o ambiente do servidor
DATABASE_URL="postgresql://sigecontratos_user:sigecontratos_password@localhost:5432/sigecontratos_db?schema=public"

# Chave secreta para geração de tokens JWT (mantenha em segredo)
JWT_SECRET="sigecontratos_jwt_super_secret_key_13303"

# Validade do token de login
JWT_EXPIRATION="24h"

# Porta do servidor backend
PORT=3001
