# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com credenciais reais — ele já está no .gitignore.

# ── Banco de dados (Supabase PostgreSQL) ─────────────────────────────────────
# DATABASE_URL: usada pela aplicação em runtime (todas as queries do Prisma).
#   - Local/Docker: aponta para o Postgres local (docker-compose.yml).
#   - Produção (Vercel): use o SUPABASE TRANSACTION POOLER (porta 6543), com
#     "?pgbouncer=true&connection_limit=1" no final — funções serverless abrem
#     muitas conexões curtas e o Transaction Pooler evita esgotar o Postgres.
#     Formato: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sigecontratos_db"

# DIRECT_URL: usada apenas por `prisma migrate` / `prisma db push` (DDL).
#   - O Transaction Pooler (6543) não suporta essas operações.
#   - Use a conexão direta (porta 5432, "db.<ref>.supabase.co") ou o Session
#     Pooler (porta 5432, "aws-0-<regiao>.pooler.supabase.com") do Supabase.
#   - Em dev local pode ser igual à DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sigecontratos_db"

# ── Autenticação ──────────────────────────────────────────────────────────────
JWT_SECRET="troque_por_uma_string_longa_e_aleatoria_em_producao"
JWT_EXPIRATION="24h"

# ── Servidor ──────────────────────────────────────────────────────────────────
# Usado apenas no bootstrap local/Docker (src/main.ts). Na Vercel é ignorado
# (o runtime serverless define a porta automaticamente).
PORT=3001

# CORS_ORIGINS: lista de origens permitidas, separadas por vírgula.
# Se não definida, o backend reflete a origem da requisição (comportamento
# anterior). Em produção, defina explicitamente as origens confiáveis:
CORS_ORIGINS="http://localhost:3000,https://SEU-FRONTEND.vercel.app"
